# Copiez ce fichier en ".env" dans le dossier backend/ et ajustez les valeurs.
# Le fichier .env n'est jamais nécessaire pour le code : toutes ces valeurs
# ont déjà un défaut raisonnable dans app/config.py, mais il est fortement
# recommandé de les personnaliser avant une mise en production.

# --- Base de données PostgreSQL ---
# Format : postgresql+psycopg2://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
DATABASE_URL=postgresql+psycopg2://chg_user:chg_password@localhost:5432/chg_platform

# --- Sécurité ---
# Générez une valeur aléatoire longue, par exemple avec : openssl rand -hex 32
SECRET_KEY=changez-cette-cle-secrete-en-production-chg-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Compte administrateur créé automatiquement au tout premier démarrage ---
# (uniquement si la base est encore vide -- changez le mot de passe ensuite
# depuis la page Paramètres, ou modifiez ces valeurs AVANT le premier lancement)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=ChangeMoi123!
FIRST_ADMIN_EMAIL=admin@concordeholding.tg

# --- CORS ---
# Laissez "*" si le frontend est servi par ce même serveur (cas par défaut).
# Sinon, listez les origines autorisées séparées par des virgules.
CORS_ORIGINS=*

# --- Organisation ---
ORG_NAME=Concorde Holding Group
ORG_SHORT_NAME=CHG
